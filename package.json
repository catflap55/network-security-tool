{
  "name": "security-tool",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "test": "python3 -m pytest backend/tests",
    "api:install": "node scripts/run-api.js --install-only",
    "api": "node scripts/run-api.js",
    "dev:full": "concurrently -n web,api -c cyan,magenta \"npm run dev\" \"npm run api\"",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend",
    "preview": "npm run preview -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "source-map-js": "1.2.2",
    "minimatch": {
      "brace-expansion": "1.1.21"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": {
        "brace-expansion": "5.0.12"
      }
    }
  }
}
